{
  "models": {
    "providers": {
      "openai": {
        "apiKey": "OPENAI_API_KEY_PLACEHOLDER"
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-4o-mini"
      },
      "workspace": "/home/user/clawd"
    }
  },
  "gateway": {
    "port": 8080,
    "mode": "local",
    "auth": {
      "token": "GATEWAY_TOKEN_PLACEHOLDER"
    }
  },
  "plugins": {
    "entries": {
      "whatsapp": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      }
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "open",
      "allowFrom": ["*"]
    }
  }
}
