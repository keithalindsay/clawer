{
  "models": {
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "OPENAI_API_KEY_PLACEHOLDER",
        "models": [
          {
            "id": "gpt-4o-mini",
            "name": "GPT-4o Mini",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {
              "input": 0.15,
              "output": 0.60
            },
            "contextWindow": 128000,
            "maxTokens": 16384
          }
        ]
      },
      "gemini": {
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "apiKey": "GEMINI_API_KEY_PLACEHOLDER",
        "models": [
          {
            "id": "gemini-3-flash",
            "name": "Gemini 3 Flash",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {
              "input": 0.50,
              "output": 3.00
            },
            "contextWindow": 1000000,
            "maxTokens": 16384
          },
          {
            "id": "gemini-2.0-flash",
            "name": "Gemini 2.0 Flash",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {
              "input": 0.10,
              "output": 0.40
            },
            "contextWindow": 1000000,
            "maxTokens": 8192
          },
          {
            "id": "gemini-2.0-flash-lite",
            "name": "Gemini 2.0 Flash Lite",
            "reasoning": false,
            "input": ["text"],
            "cost": {
              "input": 0.05,
              "output": 0.20
            },
            "contextWindow": 1000000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "gemini/gemini-3-flash"
      },
      "workspace": "/home/user/clawd"
    }
  },
  "gateway": {
    "port": 8080,
    "mode": "local",
    "auth": {
      "token": "GATEWAY_TOKEN_PLACEHOLDER"
    }
  },
  "plugins": {
    "entries": {
      "whatsapp": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "enabled": true,
        "apiKey": "searxng-local-proxy"
      },
      "fetch": {
        "enabled": true
      }
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "open",
      "allowFrom": ["*"]
    }
  }
}
