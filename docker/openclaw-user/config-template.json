{
  "models": {
    "providers": {
      "moonshot": {
        "baseUrl": "https://api.moonshot.ai/v1",
        "api": "openai-completions",
        "apiKey": "MOONSHOT_API_KEY_PLACEHOLDER",
        "models": [
          {
            "id": "moonshot-v1-32k",
            "name": "Moonshot V1 32K",
            "reasoning": false,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 32000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "moonshot/moonshot-v1-32k"
      },
      "workspace": "/home/user/clawd"
    }
  },
  "gateway": {
    "port": 8080,
    "mode": "local",
    "auth": {
      "token": "GATEWAY_TOKEN_PLACEHOLDER"
    }
  },
  "plugins": {
    "entries": {
      "whatsapp": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      }
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "open",
      "allowFrom": ["*"]
    }
  }
}
