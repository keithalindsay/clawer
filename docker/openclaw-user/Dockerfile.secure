# Hardened OpenClaw Container Image
# Version: 2026.2.6-3
# Security Level: Production
#
# Hardening applied:
# - Non-root user execution
# - Read-only root filesystem compatible
# - Minimal attack surface
# - Resource limits via ulimit
# - No privilege escalation
# - Restricted capabilities

FROM node:22-slim AS builder

# Install build dependencies only in builder stage
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install OpenClaw in builder stage
# TODO: Update to openclaw-2026.2.6-3.tgz when available
COPY openclaw-2026.2.1.tgz /tmp/
RUN npm install -g /tmp/openclaw-2026.2.1.tgz

# Production stage - minimal image
FROM node:22-slim

# Security labels
LABEL org.opencontainers.image.title="Clawer OpenClaw (Hardened)"
LABEL org.opencontainers.image.version="2026.2.6-3"
LABEL org.opencontainers.image.vendor="Clawer.ai"
LABEL security.hardened="true"
LABEL security.non-root="true"

# Install only runtime dependencies (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    dumb-init \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user with specific UID/GID for consistency
RUN groupadd --gid 1000 agent && \
    useradd --uid 1000 --gid 1000 --shell /bin/bash --create-home agent

# Set HOME for OpenClaw config discovery
ENV HOME=/home/agent
ENV NODE_ENV=production
ENV OPENCLAW_SECURITY_MODE=strict

# Create required directories with correct ownership
RUN mkdir -p /home/agent/clawd \
             /home/agent/.openclaw \
             /tmp/openclaw \
    && chown -R agent:agent /home/agent /tmp/openclaw

# Copy OpenClaw from builder
COPY --from=builder /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=builder /usr/local/bin/openclaw /usr/local/bin/openclaw

# Copy configuration files (owned by root, readable by agent)
COPY --chown=root:agent --chmod=640 config-template.secure.json /home/agent/.openclaw/openclaw.json.template
COPY --chown=root:agent --chmod=644 SOUL.md /home/agent/clawd/SOUL.md

# Copy runtime scripts
COPY --chown=root:root --chmod=755 api-server.js /usr/local/bin/api-server.js
COPY --chown=root:root --chmod=755 entrypoint-secure.sh /usr/local/bin/entrypoint.sh

# Set working directory
WORKDIR /home/agent/clawd

# Switch to non-root user
USER agent:agent

# Expose ports (unprivileged)
EXPOSE 8080 8081

# Resource limits via ulimit (defense in depth - orchestrator also limits)
# These are applied at container runtime but documented here
# --ulimit nofile=1024:1024 --ulimit nproc=256:256

# Health check - more robust with retries and proper timeout
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

# Use dumb-init as PID 1 for proper signal handling
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/entrypoint.sh"]
