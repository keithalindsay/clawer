# =============================================================================
# Clawer.ai Environment Variables
# Copy to .env.local and fill in values
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/clawer

# ── Authentication (Clerk) ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx                    # Monthly subscription price ID
# STRIPE_ANNUAL_PRICE_ID=price_xxx           # Optional: Annual subscription price ID

# ── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3002/api
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── AI Provider Keys (pushed to user containers) ─────────────────────────────
OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx                         # Optional: Google Gemini

# ── Container Orchestration ──────────────────────────────────────────────────
PRODUCTION_SERVER=root@your-server-ip        # SSH target for container management
# CONTAINER_HOST=localhost                   # Host where containers run (for API calls)

# ── Free Tier ────────────────────────────────────────────────────────────────
FREE_TIER_PORT=4000                          # Port for shared free-tier container
FREE_TIER_TOKEN=generate-a-random-token-here # Auth token for shared free-tier container

# ── Admin ────────────────────────────────────────────────────────────────────
# ADMIN_EMAILS=you@example.com               # Comma-separated admin emails (default: vavier@gmail.com)

# ── Email (Resend) ──────────────────────────────────────────────────────────
# RESEND_API_KEY=re_xxx                      # Optional: enables real email sending
# EMAIL_FROM=Clawer.ai <noreply@clawer.ai>
# ALERT_EMAIL=you@example.com                # Where to send operational alerts

# ── Redis (Rate Limiting) ────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379           # Optional: enables Redis-based rate limiting
#                                            # Without Redis, rate limiting stubs to always-allow

# ── CORS ─────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=https://clawer.ai,https://www.clawer.ai,http://localhost:3002
